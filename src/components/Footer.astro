---
import Icon from './Icon.astro';
import { SITE, waLink } from '../data/site.js';
import { CATEGORIES } from '../data/products.js';
import { C } from '../data/content.js';
const year = new Date().getFullYear();
const cats = CATEGORIES.map((c) => ({ href: `/products/?cat=${c.slug}`, label: c.name }));
const quick = [
  { href: '/', label: C.nav.home },
  { href: '/products/', label: C.nav.products },
  { href: '/about/', label: C.nav.about },
  { href: '/contact/', label: C.nav.contact },
];
const intro = 'Assalam-o-Alaikum! I would like to know more about Arfa Chemicals products.';
---
<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <div class="fabout">
        <img class="logo-f" src="/images/logo.png" alt={`${SITE.name} logo`} />
        <p>{C.footer.blurb}</p>
      </div>

      <div>
        <h4>{C.footer.quickLinks}</h4>
        <ul>
          {quick.map((q) => (
            <li><a href={q.href}>{q.label}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h4>{C.footer.range}</h4>
        <ul>
          {cats.map((c) => (
            <li><a href={c.href}>{c.label}</a></li>
          ))}
        </ul>
      </div>

      <div class="fcontact">
        <h4>{C.footer.contactH}</h4>
        <p><Icon name="phone" size={15} /><a href={`tel:${SITE.phoneHref}`}>{SITE.phoneDisplay}</a></p>
        <p><Icon name="chat" size={15} /><a href={waLink(intro)} target="_blank" rel="noopener">{C.footer.whatsappUs}</a></p>
        <p><Icon name="mail" size={15} /><a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
        <p><Icon name="pin" size={15} /><span>{SITE.address}</span></p>
        <p><Icon name="clock" size={15} /><span>{SITE.hours}</span></p>
      </div>
    </div>
  </div>
  <div class="footer-bottom">
    <div class="container">
      <span>© {year} {SITE.name}. All rights reserved.</span>
      <span>{C.footer.disclaimer}</span>
    </div>
  </div>
</footer>

<a
  class="wa-float"
  href={waLink(intro)}
  target="_blank"
  rel="noopener"
  aria-label={C.footer.whatsappUs}
  title={C.footer.whatsappUs}
><Icon name="chat" size={26} /></a>

<style>
  .wa-float {
    position: fixed; right: 22px; bottom: 22px; z-index: 80;
    width: 58px; height: 58px; border-radius: 50%;
    background: #22a34a; color: #fff; display: grid; place-items: center;
    box-shadow: 0 10px 30px rgba(18, 140, 60, 0.45);
    transition: transform 0.2s ease, background 0.2s ease;
  }
  .wa-float:hover { background: #1a8740; color: #fff; transform: translateY(-3px) scale(1.04); }
</style>
