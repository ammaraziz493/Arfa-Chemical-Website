---
import Icon from './Icon.astro';
import { SITE, waLink } from '../data/site.js';
import { C } from '../data/content.js';
const { pathname = '' } = Astro.url;
const nav = [
  { href: '/', label: C.nav.home },
  { href: '/products/', label: C.nav.products },
  { href: '/about/', label: C.nav.about },
  { href: '/contact/', label: C.nav.contact },
];
const isActive = (href) => (href === '/' ? pathname === '/' || pathname === '/index.html' : pathname.startsWith(href));
const intro = 'Assalam-o-Alaikum! I would like to know more about Arfa Chemicals products.';
---
<div class="topbar">
  <div class="container">
    <div class="tb-group">
      <a href={`tel:${SITE.phoneHref}`}><span class="tb-icon"><Icon name="phone" size={13} /></span>{SITE.phoneDisplay}</a>
      <a href={`mailto:${SITE.email}`}><span class="tb-icon"><Icon name="mail" size={13} /></span>{SITE.email}</a>
    </div>
    <div class="tb-group tb-hide">
      <span><Icon name="clock" size={13} /> {SITE.hours}</span>
    </div>
  </div>
</div>

<header class="header" id="site-header">
  <div class="container">
    <a class="brand" href="/" aria-label={`${SITE.name} — ${C.nav.home}`}>
      <img class="logo" src="/images/logo.png" alt={`${SITE.name} logo`} />
    </a>

    <button class="burger" id="burger" aria-label="Toggle menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>

    <nav class="nav" id="main-nav" aria-label="Main navigation">
      {nav.map((n) => (
        <a href={n.href} class:list={[isActive(n.href) && 'active']}>{n.label}</a>
      ))}
      <a
        class="btn btn-wa btn-sm"
        href={waLink(intro)}
        target="_blank"
        rel="noopener"
      >{C.nav.orderWa}</a>
    </nav>
  </div>
</header>

<script is:inline>
  (function () {
    var burger = document.getElementById('burger');
    var nav = document.getElementById('main-nav');
    if (!burger || !nav) return;
    burger.addEventListener('click', function () {
      var open = nav.classList.toggle('open');
      burger.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
    nav.querySelectorAll('a').forEach(function (a) {
      a.addEventListener('click', function () { nav.classList.remove('open'); burger.setAttribute('aria-expanded', 'false'); });
    });
  })();
</script>
