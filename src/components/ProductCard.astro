---
import ProductArt from './ProductArt.astro';
import { fmtPrice, catLabel } from '../data/products.js';
import { waLink, WA_ORDER_TEXT } from '../data/site.js';

const { product } = Astro.props;
const href = `/products/${product.slug}/`;
---
<article class="pcard" data-cat={product.category} data-name={product.name.toLowerCase()}>
  <a href={href} class="pcard-art" aria-label={product.name}>
    <ProductArt product={product} />
    {product.badge && (
      <span class={product.badge === 'Hot' ? 'badge hot' : 'badge best'}>{product.badge}</span>
    )}
  </a>

  <div class="pcard-body">
    <span class="cat-chip">{catLabel(product.category)}</span>
    <h3><a href={href}>{product.name}</a></h3>
    <div class="pack">{product.pack}</div>
    <div class="price">
      {fmtPrice(product.price)}
      <small> / pack</small>
    </div>
    <div class="pcard-actions">
      <a class="btn btn-outline btn-sm" href={href}>Details</a>
      <a class="btn btn-wa btn-sm" href={waLink(WA_ORDER_TEXT(product))} target="_blank" rel="noopener">Order</a>
    </div>
  </div>
</article>
