---
import Layout from '../layouts/Layout.astro';
---
<Layout
  title="Page not found — Arfa Chemicals"
  description="The page you are looking for could not be found."
>
  <section style="min-height:50vh; display:grid; place-items:center">
    <div class="container center" style="text-align:center">
      <div style="font-size:80px; font-weight:800; color:var(--blue); line-height:1">404</div>
      <h1 style="color:var(--blue-deep)">This page has gone to harvest</h1>
      <p style="color:var(--ink-soft); max-width:44ch; margin:0 auto 26px">
        The page you are looking for doesn't exist or has moved. Head back home or browse the product range.
      </p>
      <a class="btn btn-blue" href="/">Back to homepage</a>
    </div>
  </section>
</Layout>
