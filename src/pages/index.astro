---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import ProductArt from '../components/ProductArt.astro';
import ProductCard from '../components/ProductCard.astro';
import { SITE, waLink } from '../data/site.js';
import { PRODUCTS, CATEGORIES } from '../data/products.js';
import { C } from '../data/content.js';

const bestSellers = PRODUCTS.filter((p) => p.featured);
const heroProduct = bestSellers[0];
const catCount = (slug) => PRODUCTS.filter((p) => p.category === slug).length;
const H = C.home;
const intro = 'Assalam-o-Alaikum! I would like to know more about Arfa Chemicals products.';
const advice = 'Assalam-o-Alaikum! I need help choosing the right product for my crop.';
---
<Layout>
  <!-- ============ HERO ============ -->
  <section class="hero">
    <div class="container">
      <div>
        <span class="eyebrow">{H.eyebrow}</span>
        <h1>{H.h1}<em>{H.h1Em}</em></h1>
        <p class="lead">{H.lead}</p>
        <div class="hero-cta">
          <a class="btn btn-wa btn-lg" href={waLink(intro)} target="_blank" rel="noopener">
            <Icon name="chat" size={18} /> {C.nav.orderWa}
          </a>
          <a class="btn btn-white btn-lg" href="/products/">{C.nav.products}</a>
        </div>
        <div class="hero-trust">
          {H.trust.map((t) => (
            <div><span class="dot"><Icon name="check" size={14} /></span> {t}</div>
          ))}
        </div>
      </div>

      <div class="hero-visual">
        <div class="hero-float f1"><span class="fdot"></span>{H.float1.title}<small>{H.float1.sub}</small></div>
        <div class="hero-stage">
          {heroProduct?.image
            ? <img class="hero-img" src={heroProduct.image} alt={heroProduct.name} />
            : <ProductArt product={heroProduct} />}
        </div>
        <div class="hero-float f2"><Icon name="leaf" size={18} /> {H.float2.title}<small>{PRODUCTS.length} {H.float2.sub}</small></div>
      </div>
    </div>
  </section>

  <!-- ============ CATEGORIES ============ -->
  <section class="sec-light" id="categories">
    <div class="container">
      <div class="sec-head">
        <div class="kicker">{H.catKicker}</div>
        <h2>{H.catH2}</h2>
        <p>{H.catP}</p>
      </div>
      <div class="cat-grid">
        {CATEGORIES.map((cat) => (
          <a class="cat-card" href={`/products/?cat=${cat.slug}`}>
            <div class="cat-top">
              <span class="cat-dot" style={`background:var(--cat-${cat.slug})`}></span>
              <h3>{cat.name}</h3>
            </div>
            <div class="cnt">{catCount(cat.slug)} {C.ui.productsLabel}</div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ BEST SELLERS ============ -->
  <section class="sec-white">
    <div class="container">
      <div class="sec-head">
        <div class="kicker">{H.bestKicker}</div>
        <h2>{H.bestH2}</h2>
        <p>{H.bestP}</p>
      </div>
      <div class="grid">
        {bestSellers.map((p) => <ProductCard product={p} />)}
      </div>
      <div class="view-all">
        <a class="btn btn-blue" href="/products/">{C.ui.viewAll} →</a>
      </div>
    </div>
  </section>

  <!-- ============ WHY US ============ -->
  <section class="sec-light">
    <div class="container">
      <div class="why-grid">
        <div class="why-copy">
          <span class="kicker-left">{H.whyKicker}</span>
          <h2>{H.whyH2}</h2>
          <p>{H.whyP}</p>
          <a class="why-cta" href={waLink(advice)} target="_blank" rel="noopener">
            {H.whyCta} <span aria-hidden="true">→</span>
          </a>
        </div>
        <div class="why-list">
          {H.whyItems.map((w) => (
            <div class="why-item">
              <span class="wic"><Icon name={w.icon} size={24} /></span>
              <div>
                <h3>{w.title}</h3>
                <p>{w.text}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ============ HOW TO ORDER ============ -->
  <section class="sec-brand">
    <div class="container">
      <div class="sec-head">
        <div class="kicker" style="color:#8fe0ab">{H.stepsKicker}</div>
        <h2 style="color:#fff">{H.stepsH2}</h2>
        <p style="color:#c9ddf0">{H.stepsP}</p>
      </div>
      <div class="steps">
        {H.stepsItems.map((s) => (
          <div class="step">
            <div class="step-head">
              <span class="sic"><Icon name={s.icon} size={20} /></span>
              <h3>{s.title}</h3>
            </div>
            <p>{s.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ CTA ============ -->
  <section>
    <div class="container">
      <div class="cta-band">
        <div>
          <h2>{H.ctaH2}</h2>
          <p>{H.ctaP}</p>
        </div>
        <div>
          <a class="btn btn-white btn-lg" href={waLink(advice)} target="_blank" rel="noopener">
            <Icon name="chat" size={18} /> {H.ctaBtn}
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
