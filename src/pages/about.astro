---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { SITE, waLink } from '../data/site.js';
import { C } from '../data/content.js';
const A = C.aboutPage;
const intro = 'Assalam-o-Alaikum! I would like to talk to the Arfa Chemicals team.';
---
<Layout
  title={`${A.h1} — Arfa Chemicals`}
  description="Arfa Chemicals — a plant science company incorporated in 2025, importing and distributing crop protection products and seeds across Pakistan."
>
  <section class="page-hero">
    <div class="container">
      <div class="breadcrumb"><a href="/">{C.nav.home}</a> / {C.nav.about}</div>
      <h1>{A.h1}</h1>
      <p>{A.heroP}</p>
    </div>
  </section>

  <!-- ============ WHO WE ARE ============ -->
  <section class="sec-white">
    <div class="container">
      <div class="about-grid">
        <div>
          <span class="kicker-left">{A.kicker}</span>
          <h2>{A.h2}</h2>
          {A.paras.map((p) => <p>{p}</p>)}
        </div>
        <div class="about-panel">
          <h3>{A.visionH}</h3>
          <p style="color:#d3e4f5; font-size:14.5px">{A.visionP}</p>
          <h3 style="margin-top:22px">{A.ambitionH}</h3>
          <p style="color:#d3e4f5; font-size:14.5px">{A.ambitionP}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ WHAT WE SUPPLY ============ -->
  <section class="sec-light">
    <div class="container">
      <div class="sec-head">
        <div class="kicker">{A.supplyKicker}</div>
        <h2>{A.supplyH2}</h2>
        <p>{A.supplyP1}</p>
      </div>
      <div class="sec-head" style="max-width:760px; margin-top:-18px">
        <p>{A.supplyP2}</p>
      </div>

      <div class="pillars" style="margin-top:40px">
        {A.values.map((v) => (
          <div class="pillar">
            <div class="pic"><Icon name={v.icon} size={26} /></div>
            <h3>{v.title}</h3>
            <p>{v.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ CTA ============ -->
  <section class="sec-white">
    <div class="container">
      <div class="cta-band">
        <div>
          <h2>{A.ctaH2}</h2>
          <p>{A.ctaP}</p>
        </div>
        <div>
          <a class="btn btn-white btn-lg" href={waLink(intro)} target="_blank" rel="noopener">
            <Icon name="chat" size={18} /> {A.ctaBtn}
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
